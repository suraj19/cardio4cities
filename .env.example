# RUN_MODE controls everything: LIVE does real research, MOCK exercises the
# orchestration offline with canned data and no keys.
RUN_MODE=LIVE

# --- LLM -------------------------------------------------------------
# Any OpenAI-compatible chat endpoint. Embeddings are generated locally, so
# the provider only needs to serve chat completions.
#
# TWO models, not one, because a run makes two kinds of call:
#
#   LLM_MODEL       ~30 calls  judgement — query planning, adjudicating a
#                              claim, the narrative, /ask
#   LLM_BULK_MODEL  ~120 calls mechanical — turning a page into claim JSON,
#                              and Graphiti's entity extraction
#
# The bulk calls fill a fixed schema from text in front of them. There is no
# judgement in them, and Small 4 costs a third of Large 3 ($0.15/$0.60 per 1M
# tokens against $0.50/$1.50). Pointing both settings at the same model is
# the single most expensive change you can make here.
#
# Mistral (default). Get a key at https://console.mistral.ai — phone
# verification, no card. Its free "Experiment" plan is the only free tier
# that can finish a city: 1B tokens/month against the 400-600k a run needs,
# so you are throttled on request RATE and never walled on volume. Check
# yours in Admin Panel > API > Limits; it decides how long a run takes, not
# whether it finishes.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-medium-latest
LLM_BULK_MODEL=mistral-small-latest
LLM_API_KEY=
#
# Medium rather than Large for judgement because Large 3 is NOT served on the
# free tier — it is absent from GET /v1/models for a free key and returns
# 403 'tier_not_allowed' (code 1910). On a PAID key switch LLM_MODEL to
# mistral-large-latest: it is both stronger and ~3x cheaper than Medium 3.5
# ($0.50/$1.50 per 1M against $1.50/$7.50), so this default is the expensive
# one once you start paying.
#
# Confirm what your own key can reach rather than trusting either of us:
#   curl https://api.mistral.ai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
#
# Pin the generation (mistral-large-3, mistral-small-4) or the exact build
# (mistral-large-2512, mistral-small-2603) if you need reproducibility: the
# -latest aliases roll across generations, and Mistral's own lifecycle policy
# warns that behaviour AND pricing can change under them.
#
# Two Mistral notes worth knowing before you demo:
#   - Requests on the free Experiment plan may be used to train Mistral's
#     models unless you opt out in the Admin Console (Privacy). Paid plans
#     are opted out by default.
#   - Mistral's Batch API is 50% cheaper AND exempt from rate limits, which
#     would remove the throttle entirely. It needs a submit-and-poll
#     rewrite of app/llm/client.py, so it is not wired up here.
#
# Alternatives, both settings each:
# DeepSeek    LLM_BASE_URL=https://api.deepseek.com/v1 · no free tier, but no
#             RPM/TPM/RPD limits either — only 2500 concurrency, which is the
#             best shape available for this burst workload. ~$0.13/city.
#             Set LLM_BULK_REASONING_EFFORT= and pass thinking disabled, or
#             it silently reasons at "high" on every call.
# Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#             Models gemini-3.5-flash / gemini-3.1-flash-lite, efforts
#             low / minimal. Free tier is 20 req/DAY and cannot finish one
#             pass; a billed Tier 1 key works and costs ~$0.45/city.
# Groq        LLM_BASE_URL=https://api.groq.com/openai/v1 · rejects
#             reasoning_effort, so clear BOTH settings. Free tier caps at
#             100k tokens/day on the 70B model — about a fifth of one city.
# OpenAI      LLM_BASE_URL=https://api.openai.com/v1
# Ollama      LLM_BASE_URL=http://host.docker.internal:11434/v1 · unmetered
#             and keyless, but needs a ~30B+ model or extraction invents
#             fields. Clear both reasoning-effort settings.

# Which model Graphiti runs its own extraction on. Defaults to LLM_BULK_MODEL,
# which is where the majority of a run's calls live.
# GRAPHITI_MODEL=

# Thinking effort — a cost control, not a quality dial: thinking tokens bill
# at the OUTPUT rate and come out of the same budget as the answer.
#
# The two defaults differ because the MODELS differ, not the roles. Small 4 is
# a hybrid instruct/reasoning model and implements the parameter; Large 3 does
# not, and a shim rejects a parameter it does not implement rather than
# ignoring it — so a value in the first setting 400s every judgement call.
# Empty means "send no such field".
#
# "none" is a value Mistral defines (answer directly, no thinking trace), not
# an absence. Valid values on Small 4 are only "none" and "high".
LLM_REASONING_EFFORT=
LLM_BULK_REASONING_EFFORT=none

# Output ceilings. These bound thinking tokens too, so cutting them to the
# size of the expected answer backfires: a model that runs out mid-thought
# returns an empty string, which every caller here reads as "nothing found".
LLM_MAX_TOKENS=4096
LLM_BULK_MAX_TOKENS=2048

# Graphiti's separate, larger budget for entity extraction. It has no
# reasoning_effort setting, so on a thinking model headroom is the only
# protection against empty responses. Set too low, the symptom is a knowledge
# graph with no fact edges rather than an error.
GRAPHITI_MAX_TOKENS=16384

# --- Embeddings (local, no API key) ----------------------------------
# Shared by Milvus and by Graphiti's embedder and reranker.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Search discovery -------------------------------------------------
# Leave blank to fall back to duckduckgo-search (no key required, lower quality).
TAVILY_API_KEY=

# --- Relational store -------------------------------------------------
# Point at Postgres in a real deployment:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/cardio4cities
DATABASE_URL=sqlite:///./data/cardio4cities.db

# --- Vector store -----------------------------------------------------
# A path ending in .db runs Milvus Lite embedded — no server to operate.
# For a real cluster: http://localhost:19530, or a Zilliz Cloud endpoint.
MILVUS_URI=./data/milvus.db
MILVUS_TOKEN=
MILVUS_COLLECTION=city_passages

# --- Graph store: Neo4j Graph Database Sandbox ------------------------
# Create at https://sandbox.neo4j.com, open the "Connection details" tab and
# copy the Bolt URL + password. A Sandbox looks like bolt://<ip>:7687; an Aura
# instance looks like neo4j+s://<id>.databases.neo4j.io — either works.
# Sandboxes expire after 3 days (extendable to 10) and come back with a NEW ip
# and password, so re-copy both rather than only the password.
NEO4J_URI=bolt://0.0.0.0:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Research policy --------------------------------------------------
# How many independent sources a fact needs before it can be called VERIFIED.
MIN_SOURCES_FOR_VERIFIED=2
# How many of the five dimensions must yield a usable fact before the brief is
# written. Below this, the planner re-plans the dimensions that came back empty.
MIN_DIMENSIONS_COVERED=3
MAX_PLANNER_RETRIES=2

# --- Cost and latency budget ------------------------------------------
# Each of these bounds a multiplier. Raise them for a more thorough (slower,
# pricier) run; lower them for a faster demo.
QUERIES_PER_DIMENSION=2
MAX_SOURCES_PER_DIMENSION=4
MAX_CLAIMS_PER_PASSAGE=3
FACT_CHECK_CONTEXT_PASSAGES=4
FACT_CHECK_CONTEXT_CHARS=1500
# How many claims share one adjudication call. Lower to 1 to restore strictly
# one call per claim, which is the most conservative setting.
FACT_CHECK_BATCH_SIZE=5

# How much of a page is KEPT (indexed for /ask) versus how much is SENT to
# the claim extractor. The second is the run's largest single payload — one
# call per source, carrying the page — and the window sent is chosen by
# overlap with the dimension brief rather than taken from the top of the
# page, so the smaller budget loses boilerplate rather than signal.
PASSAGE_CHAR_LIMIT=5000
EXTRACTION_CHAR_LIMIT=2500

# --- Concurrency ------------------------------------------------------
# Parallel LLM calls during extraction and fact-checking. Keep at or under
# your provider's request-rate allowance. 1 is right for a throttled free
# key; raise to 4-8 on a paid key for roughly that much more speed.
LLM_MAX_CONCURRENCY=1
# Parallel work that costs no tokens: robots.txt, the X-Robots-Tag HEAD
# request, page fetches. Separate from the above because it is limited by
# sockets rather than by a quota — sharing one number meant the provider's
# rate limit silently throttled the crawler too.
HTTP_MAX_CONCURRENCY=8
# Parallel search queries. Deliberately lower: `ddgs` scrapes consumer
# engines and answers a burst with a Ratelimit error.
SEARCH_MAX_CONCURRENCY=3
# Parallel Graphiti episode writes. 1 is not timidity — add_episode resolves
# each entity against the existing graph, so concurrent episodes naming the
# same organization can both create it. Raise it to shorten the run's longest
# node, accepting some duplicate entities.
GRAPH_WRITE_CONCURRENCY=1
# Graphiti's OWN concurrency, which LLM_MAX_CONCURRENCY does not govern. It
# defaults to 20 internally and is the largest caller in a run, so this is
# the setting people miss. Raise it together with LLM_MAX_CONCURRENCY above.
GRAPHITI_SEMAPHORE_LIMIT=1
HTTP_TIMEOUT_SECONDS=12

# --- Research jobs ----------------------------------------------------
# POST /research registers a job and returns an id to poll; it does not wait
# for the run. Concurrency is capped because SQLite takes one writer at a
# time — raise it only with DATABASE_URL pointed at Postgres.
MAX_CONCURRENT_RESEARCH=2
# How long a finished job stays pollable. The brief itself is stored
# permanently, so expiry costs the progress detail and not the deliverable.
JOB_RETENTION_SECONDS=3600
# Load the embedding model at startup rather than on the first request, so
# the ~60s cold-start load does not land on a user.
PREWARM_EMBEDDINGS=true
