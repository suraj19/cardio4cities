# RUN_MODE controls everything: LIVE does real research, MOCK exercises the
# orchestration offline with canned data and no keys.
RUN_MODE=LIVE

# --- LLM -------------------------------------------------------------
# Any OpenAI-compatible chat endpoint. Embeddings are generated locally,
# so the provider only needs to serve chat completions — pick one block.
#
# Google Gemini (default; strongest JSON adherence for the graph layer).
# Get a key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
#   gemini-3.8-flash  most capable Flash, introductory pricing to 2026-12-31
#   gemini-flash-latest  auto-tracks the newest Flash release
#   Do NOT use gemini-2.5-flash — retired 2026-10-20.
#
# DeepSeek (cheapest; deepseek-chat was retired 2026-07-24)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-flash
#
# Groq (fastest; avoid small models, they break structured extraction)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# Optional: cheaper model for Graphiti's internal extraction passes.
# LLM_SMALL_MODEL=

# Gemini 3 and OpenAI o-series models always think, and thinking tokens come
# out of the same budget as the answer — keep the effort low so the JSON fits.
# Clear this for providers that reject the parameter (Groq, older endpoints).
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=4096

# Graphiti's separate, larger budget for entity extraction. It has no
# reasoning_effort setting, so on a thinking model headroom is the only
# protection against empty responses. Set too low, the symptom is a knowledge
# graph with no fact edges rather than an error.
GRAPHITI_MAX_TOKENS=16384

# --- Embeddings (local, no API key) ----------------------------------
# Shared by Milvus and by Graphiti's embedder and reranker.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Search discovery -------------------------------------------------
# Leave blank to fall back to duckduckgo-search (no key required, lower quality).
TAVILY_API_KEY=

# --- Relational store -------------------------------------------------
# Point at Postgres in a real deployment:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/cardio4cities
DATABASE_URL=sqlite:///./data/cardio4cities.db

# --- Vector store -----------------------------------------------------
# A path ending in .db runs Milvus Lite embedded — no server to operate.
# For a real cluster: http://localhost:19530, or a Zilliz Cloud endpoint.
MILVUS_URI=./data/milvus.db
MILVUS_TOKEN=
MILVUS_COLLECTION=city_passages

# --- Graph store: Neo4j Graph Database Sandbox ------------------------
# Create at https://sandbox.neo4j.com, open the "Connection details" tab and
# copy the Bolt URL + password. A Sandbox looks like bolt://<ip>:7687; an Aura
# instance looks like neo4j+s://<id>.databases.neo4j.io — either works.
# Sandboxes expire after 3 days (extendable to 10) and come back with a NEW ip
# and password, so re-copy both rather than only the password.
NEO4J_URI=bolt://0.0.0.0:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Research policy --------------------------------------------------
# How many independent sources a fact needs before it can be called VERIFIED.
MIN_SOURCES_FOR_VERIFIED=2
# How many of the five dimensions must yield a usable fact before the brief is
# written. Below this, the planner re-plans the dimensions that came back empty.
MIN_DIMENSIONS_COVERED=3
MAX_PLANNER_RETRIES=2

# --- Cost and latency budget ------------------------------------------
# Each of these bounds a multiplier. Raise them for a more thorough (slower,
# pricier) run; lower them for a faster demo.
QUERIES_PER_DIMENSION=2
MAX_SOURCES_PER_DIMENSION=4
MAX_CLAIMS_PER_PASSAGE=3
FACT_CHECK_CONTEXT_PASSAGES=4
FACT_CHECK_CONTEXT_CHARS=1500
PASSAGE_CHAR_LIMIT=5000
# Parallel LLM calls during extraction and fact-checking. Keep under your
# provider's rate limit — Gemini free tier wants this at 2 or 3.
LLM_MAX_CONCURRENCY=8
HTTP_TIMEOUT_SECONDS=12
