RUN_MODE=LIVE

# --- LLM: Mistral -----------------------------------------------------
# Key from https://console.mistral.ai (phone verification, no card). The free
# Experiment plan gives 1B tokens/month, which is ~1600 cities' worth — you
# are throttled on request rate, never walled on volume, so a run always
# finishes. Read your actual rate off Admin Panel > API > Limits.
LLM_BASE_URL=https://api.mistral.ai/v1
# Medium, not Large: Large 3 is not served on the free tier and returns
# 403 'tier_not_allowed'. On a paid key switch to mistral-large-latest, which
# is both better and ~3x cheaper than Medium 3.5.
LLM_MODEL=mistral-medium-latest
LLM_BULK_MODEL=mistral-small-latest
LLM_API_KEY=vL2yQOSRcMBXaRYPx1cazeBoef7KVNe6
# Empty on purpose: Large 3 does not implement reasoning_effort and rejects
# it. Small 4 does, and "none" means answer directly with no thinking trace.
LLM_REASONING_EFFORT=
LLM_BULK_REASONING_EFFORT=none
LLM_MAX_TOKENS=4096
LLM_BULK_MAX_TOKENS=2048
# Graphiti's extraction budget — larger, and it has no reasoning_effort knob.
GRAPHITI_MAX_TOKENS=16384

# --- Embeddings (local, no key) ---------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Search discovery -------------------------------------------------
# Blank falls back to duckduckgo-search, which needs no key but returns
# noisier results. Get a key at https://app.tavily.com for better sources.
TAVILY_API_KEY=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

# --- Relational store -------------------------------------------------
DATABASE_URL=sqlite:///./data/cardio4cities.db

# --- Vector store -----------------------------------------------------
# Milvus Lite (embedded). Linux/macOS only — on Windows, run in Docker or
# point this at a Zilliz Cloud endpoint.
MILVUS_URI="http://localhost:19530"
MILVUS_TOKEN=
MILVUS_COLLECTION=city_passages

# --- Graph store: Neo4j Sandbox ---------------------------------------
# Created 2026-09-11. Sandboxes expire after 3 days unless extended to 10
# from the sandbox.neo4j.com console — the IP and password both change if
# you have to recreate it.
NEO4J_URI=bolt://3.219.30.119:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=soap-capabilities-coats

# --- Research policy --------------------------------------------------
MIN_SOURCES_FOR_VERIFIED=2
MIN_DIMENSIONS_COVERED=3
MAX_PLANNER_RETRIES=2

# --- Cost and latency budget ------------------------------------------
# Both at 1 because the free Experiment plan throttles request rate. Raise
# them together on a paid key — GRAPHITI_SEMAPHORE_LIMIT is the one people
# miss, and Graphiti makes more calls per run than the rest of the pipeline.
LLM_MAX_CONCURRENCY=1
GRAPHITI_SEMAPHORE_LIMIT=1
QUERIES_PER_DIMENSION=2
MAX_SOURCES_PER_DIMENSION=4
MAX_CLAIMS_PER_PASSAGE=3
