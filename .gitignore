# Secrets. `.env.example` is the committed one and is the deliverable the
# case study asks for ("environment configuration guidance"); `.env` holds
# live keys and must never be pushed. The Neo4j Sandbox credentials file and
# the connection log are named explicitly because they arrive with those
# names from the Sandbox console and are easy to commit without noticing.
.env
.env.*
!.env.example
*Sandbox*Credentials*.txt
connection_logs.txt

# Local data: SQLite file, Milvus Lite database, cached embedding model
data/
*.db
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
